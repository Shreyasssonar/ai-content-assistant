// prisma/schema.prisma
// Prisma schema for AI Content Assistant
// SQLite database with a single Entry model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A user-submitted text entry enriched by Gemini AI.
model Entry {
  id           Int      @id @default(autoincrement())
  originalText String   // The raw text submitted by the user
  summary      String   // One-sentence summary generated by Gemini
  tags         String   // JSON-encoded array of exactly 3 tags, e.g. '["tag1","tag2","tag3"]'
  createdAt    DateTime @default(now())
}
