    "db:studio": "prisma studio",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@google/genai": "^1.5.0",
    "@prisma/client": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.2"
  }
}
