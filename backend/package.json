{
  "name": "ai-content-assistant-backend",
  "version": "1.0.0",
  "description": "Express + Prisma backend for AI Content Assistant",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
